# Copy this file to `.env` and adjust if needed.
# `.env` is git-ignored and stays on your machine.
#
# Anything in here is sent to the browser and can be read by anyone
# using the site. Addresses are fine. Never put passwords or keys here.
#
# Only names starting with VITE_ are picked up.

# Where the backend is running.
# Local development: http://localhost:5000
# Live site:         https://blog-app-backend-aw0i.onrender.com
VITE_API_URL=http://localhost:5000
