# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and must never be committed.

# Port the Express server listens on.
PORT=5000

# MongoDB Atlas connection string.
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=

# Secret used to sign JWTs. Generate a fresh random one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# How long a login token stays valid.
JWT_EXPIRES_IN=1d

# The address of the frontend that is allowed to talk to this server.
# Local development: http://localhost:5173
# Live site:         https://blog-app-1-ms9i.onrender.com
CLIENT_URL=http://localhost:5173
